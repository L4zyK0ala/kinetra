# Zorunlu: kimlik bilgilerini veritabanında şifrelemek için Fernet anahtarı. Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FITDASH_ENCRYPTION_KEY=

FITDASH_DATABASE_URL=sqlite:///fitdash.db
FITDASH_HOST=127.0.0.1
FITDASH_PORT=8010
FITDASH_SYNC_INTERVAL_MINUTES=45
FITDASH_SYNC_LOOKBACK_DAYS=14
FITDASH_TIMEZONE=Europe/Istanbul
# Tarayıcının uygulamaya ulaştığı adres (Strava OAuth dönüşü için), örn. https://kinetra.internal
FITDASH_PUBLIC_URL=http://localhost:8010

# Strava: strava.com/settings/api → "API Application". Yeni uygulamalar 1 sporcuyla sınırlı;
# ikinci profil kendi Strava uygulamasını Ayarlar sayfasından girebilir.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SILENCE_TOKEN_WARNINGS=true

# İsteğe bağlı: Claude koç sohbeti (console.anthropic.com). Boşsa koç sekmesi kapalı kalır.
ANTHROPIC_API_KEY=
FITDASH_COACH_MODEL=claude-opus-5-5
FITDASH_COACH_EFFORT=medium
FITDASH_COACH_MONTHLY_BUDGET_USD=10

# İsteğe bağlı: tüm profiller için ortak Telegram botu (profil başına bot Ayarlar'dan da eklenebilir)
TELEGRAM_BOT_TOKEN=
FITDASH_EVENING_CHECK_HOUR=21
