# /etc/systemd/system/kinetra.service — KULLANICI ve /opt/kinetra yollarını kendine göre değiştir.
[Unit]
Description=Kinetra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=KULLANICI
WorkingDirectory=/opt/kinetra
EnvironmentFile=/opt/kinetra/.env
ExecStart=/opt/kinetra/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=10
SyslogIdentifier=kinetra

[Install]
WantedBy=multi-user.target
